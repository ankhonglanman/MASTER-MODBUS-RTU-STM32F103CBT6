{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "./bin/executable.elf",
            "name": "Debug with ST-Link",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink"
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "./bin/executable.elf",
            "name": "Debug with ST-Link",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink"
        },
        {
            "name": "STM32 Nạp & Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32F103CB",
            // Chỉ định file openocd.exe
            "openOCDPath": "C:/Users/anvu8/Coding/openocd-20260302/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            // Chỉ định thư mục scripts chứa interface & target
            "searchDir": [
                "C:/Users/anvu8/Coding/openocd-20260302/OpenOCD-20260302-0.12.0/share/openocd/scripts"
            ],

            "gdbPath": "arm-none-eabi-gdb",
            "openOCDArgs": [
                "-c", "reset_config srst_only srst_nogate connect_assert_srst"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build"
        }
    ]
}